 "hint": "The nightly job also mixes in synthetic events while real traffic is small; the CloudWatch alarm exists in prod only.",
 "sections": [
  {
   "title": "Flow steps",
   "open": true,
   "ordered": true,
   "items": [
    {
     "lead": "Web request.",
     "text": "The browser calls /api/* through CloudFront to the HTTP API."
    },
    {
     "lead": "Track events.",
     "text": "Lambda events stores VIEW and ADD_TO_CART events with the user id hashed by the HMAC key from SSM."
    },
    {
     "lead": "Purchase events.",
     "text": "order-confirmed from SNS reaches the events-purchase queue; its Lambda writes PURCHASE events."
    },
    {
     "lead": "Nightly pipeline.",
     "text": "At 02:00 EventBridge Scheduler runs recs-pipeline: it reads events and products, builds also-bought, for-you and bestsellers, writes a new version and switches ACTIVE only when it beats the baseline."
    },
    {
     "lead": "Serve recommendations.",
     "text": "Lambda recs reads the ACTIVE version for the home page, the product page and for-you (signed-in users, hashed id)."
    },
    {
     "lead": "Watchdog.",
     "text": "CloudWatch alarms in prod when the pipeline has not succeeded."
    }
   ]
  }
 ]
}