   "text": "TransactWriteItems: stock, order, cart",
   "anchor": "middle",
   "class": "ns"
  }
 ],
 "hint": "Email is sent only when the stack is deployed with senderEmail; the DLQ alarm exists in prod only.",
 "sections": [
  {
   "title": "Flow steps",
   "open": true,
   "ordered": true,
   "items": [
    {
     "lead": "Sign in.",
     "text": "The browser signs in to the Cognito user pool with SRP (TOTP MFA when enabled) and receives a JWT."
    },
    {
     "lead": "API request.",
     "text": "Calls go over HTTPS to CloudFront, which forwards /api/* to the HTTP API; API Gateway checks the JWT."
    },
    {
     "lead": "Cart.",
     "text": "Lambda cart reads and writes the carts table with a version check."
    },
    {
     "lead": "Place order.",
     "text": "Lambda ordering writes stock, order and cart in one TransactWriteItems, keyed by Idempotency-Key, then sends the order to SQS."
    },
    {
     "lead": "Process order.",
     "text": "Lambda order-processor marks the order CONFIRMED, emails the customer through SES and publishes order-confirmed to SNS."
    },
    {
     "lead": "Failures to DLQ.",
     "text": "A message that fails 3 times moves to the dead-letter queue instead of being lost."
    },
    {
     "lead": "Admin.",
     "text": "Lambda ordering-admin reads the byStatus index and moves orders through SHIPPED and DELIVERED, or cancels them."
    }
   ]
  }
 ]
}